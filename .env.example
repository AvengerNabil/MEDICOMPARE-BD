# Environment Configuration Template for MediCompare BD

# Server Environment
NODE_ENV=development
PORT=3000

# Backend API URL (Frontend Proxy / Direct)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="MediCompare BD"
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Backend Settings (FastAPI)
BACKEND_PORT=8000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medicompare_bd
JWT_SECRET=development_super_secret_change_in_production_32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional OCR & External integrations
TESSERACT_CMD=
SUPABASE_URL=
SUPABASE_ANON_KEY=
